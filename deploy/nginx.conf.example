# Place limit_req_zone inside nginx's http {} block.
limit_req_zone $binary_remote_addr zone=rf_sync:10m rate=30r/m;

# Place server {} inside http {}. Replace the hostname and certificate paths.
server {
    listen 443 ssl;
    http2 on;
    server_name sync.example.invalid;
    ssl_certificate /path/to/fullchain.pem;
    ssl_certificate_key /path/to/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 17m;
    limit_req zone=rf_sync burst=10 nodelay;
    limit_req_status 429;
    access_log off; # URL includes sync_id; do not retain it in access logs.

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
    }
}
